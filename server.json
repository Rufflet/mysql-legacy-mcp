{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Rufflet/mysql-legacy-mcp",
  "title": "MySQL Legacy MCP",
  "description": "MCP server for legacy MySQL 5.0–5.6: schema inspection and SELECT by default, with opt-in INSERT/UPDATE/DELETE/DDL. Live-verified against MySQL 5.0–8.0.",
  "repository": {
    "url": "https://github.com/Rufflet/mysql-legacy-mcp",
    "source": "github"
  },
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "mysql-legacy-mcp",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "MYSQL_LEGACY_HOST",
          "description": "Database host or local tunnel endpoint",
          "isRequired": true
        },
        {
          "name": "MYSQL_LEGACY_USER",
          "description": "Dedicated database reader account",
          "isRequired": true
        },
        {
          "name": "MYSQL_LEGACY_PASSWORD",
          "description": "Nonempty database account password",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "MYSQL_LEGACY_PORT",
          "description": "TCP port, 1–65535",
          "default": "3306"
        },
        {
          "name": "MYSQL_LEGACY_DATABASE",
          "description": "Optional default database"
        },
        {
          "name": "MYSQL_LEGACY_HIDE_SYSTEM_DATABASES",
          "description": "Hide mysql and information_schema from listings",
          "default": "true",
          "choices": [
            "true",
            "false"
          ]
        },
        {
          "name": "MYSQL_LEGACY_QUERY_TIMEOUT",
          "description": "Driver query timeout, 100–60000 milliseconds",
          "default": "10000"
        },
        {
          "name": "MYSQL_LEGACY_MAX_ROWS",
          "description": "SELECT response row limit, 1–1000",
          "default": "200"
        },
        {
          "name": "MYSQL_LEGACY_MAX_RESULT_BYTES",
          "description": "SELECT row-data JSON byte limit, 1024–1048576",
          "default": "262144"
        },
        {
          "name": "MYSQL_LEGACY_CONNECT_TIMEOUT",
          "description": "Connection-establishment timeout, 100–60000 milliseconds",
          "default": "10000"
        },
        {
          "name": "MYSQL_LEGACY_POOL_SIZE",
          "description": "Pooled connection limit, 1–50",
          "default": "5"
        },
        {
          "name": "MYSQL_LEGACY_ALLOW_INSERT",
          "description": "Enable the mysql_legacy_insert tool",
          "default": "false",
          "choices": [
            "true",
            "false"
          ]
        },
        {
          "name": "MYSQL_LEGACY_ALLOW_UPDATE",
          "description": "Enable the mysql_legacy_update tool (WHERE clause always required)",
          "default": "false",
          "choices": [
            "true",
            "false"
          ]
        },
        {
          "name": "MYSQL_LEGACY_ALLOW_DELETE",
          "description": "Enable the mysql_legacy_delete tool (WHERE clause always required)",
          "default": "false",
          "choices": [
            "true",
            "false"
          ]
        },
        {
          "name": "MYSQL_LEGACY_ALLOW_DDL",
          "description": "Enable the mysql_legacy_ddl tool (table-level statements only)",
          "default": "false",
          "choices": [
            "true",
            "false"
          ]
        },
        {
          "name": "MYSQL_LEGACY_DISABLE_READ_ONLY_TRANSACTIONS",
          "description": "Disable the read-only transaction wrap around mysql_legacy_select on MySQL 5.6.5+",
          "default": "false",
          "choices": [
            "true",
            "false"
          ]
        }
      ]
    }
  ]
}
