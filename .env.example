# These variables must be set in the environment of the MCP client or process.
MYSQL_LEGACY_HOST=127.0.0.1
MYSQL_LEGACY_PORT=3306
MYSQL_LEGACY_USER=legacy_schema_reader
MYSQL_LEGACY_PASSWORD=replace-with-a-secret
MYSQL_LEGACY_DATABASE=optional_default_database
MYSQL_LEGACY_HIDE_SYSTEM_DATABASES=true
MYSQL_LEGACY_QUERY_TIMEOUT=10000
MYSQL_LEGACY_MAX_ROWS=200
MYSQL_LEGACY_MAX_RESULT_BYTES=262144

# Only used by npm run smoke:live.
MYSQL_LEGACY_SMOKE_TABLE=replace_with_a_table_name
